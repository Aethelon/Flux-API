NODE_ENV=development
HOST=0.0.0.0
PORT=3333
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000

DATABASE_URL=postgres://flux:flux@localhost:5432/flux
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_STATEMENT_TIMEOUT_MS=15000
DATABASE_IDLE_TRANSACTION_TIMEOUT_MS=15000

JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

HTTP_BODY_LIMIT_BYTES=1048576
HTTP_REQUEST_TIMEOUT_MS=30000
MONITORING_TOKEN=
MONITORING_JOB_STALE_MINUTES=15
MONITORING_OUTBOX_STALE_MINUTES=5
MONITORING_FORECAST_STALE_HOURS=48
MONITORING_BACKUP_STALE_HOURS=24
MONITORING_AI_COST_ALERT_MICRO_USD=100000
LOG_RETENTION_DAYS=30
OUTBOX_RETENTION_DAYS=30
AUTH_SESSION_RETENTION_DAYS=90
BACKUP_RPO_HOURS=24
BACKUP_RTO_MINUTES=60

AI_PROVIDER=disabled
GEMINI_API_KEY=
GEMINI_MODEL_ID=gemini-3.5-flash-lite
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_ID=claude-haiku-4-5-20251001
AI_TIMEOUT_MS=20000
AI_MAX_OUTPUT_TOKENS=1500
AI_MAX_RETRIES=2
AI_CACHE_TTL_HOURS=24
AI_TEMPERATURE=0.1
AI_PROMPT_VERSION=insights-prompt-v1
AI_SCHEMA_VERSION=insights-schema-v1
AI_POLICY_VERSION=insights-policy-v1

SEED_TENANT_NAME=D'lara
SEED_TENANT_SLUG=dlara

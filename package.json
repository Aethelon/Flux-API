{
  "name": "flux-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "tsx --test --test-concurrency=1 test/**/*.test.ts",
    "db:migrate": "tsx src/database/cli.ts up",
    "db:migrate:down": "tsx src/database/cli.ts down",
    "db:seed:admin": "tsx src/database/seeds/admin.ts",
    "db:seed:demo": "tsx src/database/seeds/demo.ts",
    "db:seed:demo-history": "tsx src/database/seeds/demo-history.ts",
    "db:import:legacy-pdv": "tsx src/database/seeds/legacy-pdv.ts",
    "check": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.0",
    "@fastify/rate-limit": "11.1.0",
    "@fastify/swagger": "9.8.1",
    "@fastify/swagger-ui": "6.1.0",
    "@fastify/type-provider-typebox": "6.1.0",
    "@sinclair/typebox": "0.34.52",
    "dotenv": "17.4.2",
    "env-schema": "7.0.0",
    "fastify": "5.10.0",
    "fastify-plugin": "6.0.0",
    "jose": "6.2.4",
    "kysely": "0.29.4",
    "pg": "8.22.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "@types/pg": "8.20.0",
    "eslint": "10.7.0",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0"
  },
  "overrides": {
    "@fastify/static": "10.1.2",
    "brace-expansion": "5.0.9"
  }
}
